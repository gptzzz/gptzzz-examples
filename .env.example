# Nothing in this repository reads .env automatically. This file only lists the
# variables the examples use; set them in your shell instead:
#   read -rs GPTZZZ_API_KEY && export GPTZZZ_API_KEY
# Never commit a real key. .gitignore excludes .env and .env.* (except this file).

GPTZZZ_API_KEY=
# Optional
GPTZZZ_BASE_URL=https://gptzzz.ai/v1
GPTZZZ_MODEL=gpt-5.6
# Responses example only: low, medium, high, ... (empty = model default)
GPTZZZ_REASONING_EFFORT=
